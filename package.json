{
  "name": "praxtalk",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/build-widget-bundle.mjs",
    "dev": "concurrently -k -n convex,next -c cyan,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev",
    "prebuild": "node scripts/build-widget-bundle.mjs",
    "build": "convex deploy --cmd \"next build\"",
    "build:next-only": "next build",
    "build:widget": "node scripts/build-widget-bundle.mjs",
    "start": "next start",
    "typecheck": "tsc --noEmit && tsc -p convex --noEmit",
    "clean": "node -e \"fs.rmSync('.next',{recursive:true,force:true})\"",
    "mobile:add:ios": "cap add ios",
    "mobile:add:android": "cap add android",
    "mobile:sync": "cap sync",
    "mobile:open:ios": "cap open ios",
    "mobile:open:android": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@fingerprintjs/fingerprintjs": "^5.2.0",
    "bcryptjs": "^3.0.3",
    "convex": "^1.36.1",
    "disposable-email-domains": "^1.0.62",
    "imapflow": "^1.3.3",
    "next": "16.2.4",
    "nodemailer": "^8.0.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.12.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
