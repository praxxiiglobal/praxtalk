# Copy to .env.local and fill in after running `npx convex dev`.
# Convex CLI auto-populates these on first deploy.

# Convex deployment slug (dev/prod) — server-side only
CONVEX_DEPLOYMENT=

# Public Convex URL — exposed to the browser via NEXT_PUBLIC_*
NEXT_PUBLIC_CONVEX_URL=

# ── PayPal billing ──────────────────────────────────────────────────
# These live as Convex env vars (set with `npx convex env set KEY=value`),
# NOT in this Next.js .env. Listed here as documentation only.
#
# PAYPAL_MODE          = sandbox | live   (defaults to sandbox)
# PAYPAL_CLIENT_ID     = REST app client id
# PAYPAL_CLIENT_SECRET = REST app secret
# PAYPAL_WEBHOOK_ID    = id of the webhook configured at
#                        api-m.{sandbox.,}paypal.com/v1/notifications/webhooks
# PAYPAL_PLAN_ID_TEAM  = id of the Team subscription plan (P-XXXX...)
# PAYPAL_PLAN_ID_SCALE = id of the Scale subscription plan (P-XXXX...)
# PAYPAL_RETURN_URL    = where PayPal redirects after approval
#                        (e.g. https://app.praxtalk.com/app/billing?paypal=approved)
# PAYPAL_CANCEL_URL    = where PayPal redirects on user cancel

# ── Razorpay billing (INR) ──────────────────────────────────────────
# Set in Convex env. INR-denominated alternative to PayPal — useful
# for India-resident customers who can't fund PayPal subs from a
# domestic bank.
#
# RAZORPAY_KEY_ID         = REST API key id (rzp_test_…/rzp_live_…)
# RAZORPAY_KEY_SECRET     = REST API key secret
# RAZORPAY_WEBHOOK_SECRET = HMAC secret set in Razorpay → Webhooks
# RAZORPAY_PLAN_ID_TEAM   = id of the Team subscription plan (plan_…)
# RAZORPAY_PLAN_ID_SCALE  = id of the Scale subscription plan (plan_…)
# RAZORPAY_RETURN_URL     = where Razorpay redirects after auth payment
#                           (e.g. https://praxtalk.com/app/billing?razorpay=approved)
#
# Webhook URL to register in Razorpay Dashboard → Settings → Webhooks:
#   https://<your-prod-convex-deployment>.convex.site/api/razorpay/webhook
# Subscribe to events:
#   subscription.activated · charged · resumed · updated · paused ·
#   halted · pending · cancelled · completed · expired

# ── Browser push notifications (Web Push / VAPID) ───────────────────
# Convex env vars. Generate keys once with:
#   npx web-push generate-vapid-keys
#
# VAPID_PUBLIC_KEY  = sent to the browser; used to verify push origin
# VAPID_PRIVATE_KEY = signs the JWT we send to the push service
# VAPID_SUBJECT     = mailto: address shown to push services on errors
#                     (defaults to mailto:hello@praxtalk.com)

# ── Calendar OAuth (Phase 3, optional) ──────────────────────────────
# Convex env vars. Register an OAuth app with each provider:
#   Google:    https://console.cloud.google.com → OAuth consent + Credentials
#   Microsoft: https://entra.microsoft.com → App registrations
# The redirect URI to register at the provider is:
#   https://<your-prod-convex-deployment>.convex.site/api/oauth/calendar/<provider>/callback
# (override with PRAXTALK_OAUTH_REDIRECT_BASE if you front Convex with
# a custom domain.)
#
# GOOGLE_OAUTH_CLIENT_ID
# GOOGLE_OAUTH_CLIENT_SECRET
# MICROSOFT_OAUTH_CLIENT_ID
# MICROSOFT_OAUTH_CLIENT_SECRET
# PRAXTALK_OAUTH_REDIRECT_BASE  (optional, defaults to prod convex.site)
# PRAXTALK_DASHBOARD_BASE       (optional, defaults to https://praxtalk.com)
